    // src/background/service-worker.ts

    import { VertexAIClient } from './vertex-client';
    import { ActionPlanner } from './action-planner';
    import { MessageType, ActionStep, PageSnapshot } from '../shared/messages';

    const vertex = new VertexAIClient();
    const planner = new ActionPlanner();

    // --- Lifecycle ---

    chrome.action.onClicked.addListener(async (tab) => {
      if (tab.id) {
        await chrome.sidePanel.open({ tabId: tab.id });
      }
    });

    chrome.runtime.onInstalled.addListener(() => {
      chrome.sidePanel.setPanelBehavior({ openPanelOnActionClick: true });
    });

    // --- Message routing ---

    chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
      handleMessage(msg, sender)
        .then(sendResponse)
        .catch((err) => sendResponse({ error: err.message }));
      return true; // keep channel open for async
    });

    // Long-lived connections pour le streaming
    chrome.runtime.onConnect.addListener((port) => {
      if (port.name === 'stream') {
        handleStreamConnection(port);
      }
    });

    async function handleMessage(msg: any, sender: chrome.runtime.MessageSender) {
      switch (msg.type) {

        // ========== CHAT SIMPLE ==========
        case MessageType.CHAT_QUERY: {
          // Récupérer le contexte de la page active
          const tab = await getActiveTab();
          let pageContext = '';

          if (tab?.id) {
            try {
              const snapshot: PageSnapshot = await chrome.tabs.sendMessage(
                tab.id,
                { type: MessageType.GET_SNAPSHOT }
              );
              pageContext = `\n\nPage actuelle: ${snapshot.content.url}\nTitre: ${snapshot.content.title}\nContenu:\n${snapshot.content.text.slice(0, 3000)}`;
            } catch {
              // Tab sans content script (chrome://, etc.)
            }
          }

          const response = await vertex.generateContent(
            msg.query + pageContext,
            {
              systemInstruction:
                'Tu es un assistant de navigation intelligent. ' +
                'Réponds de manière concise et utile en te basant sur le contenu de la page si fourni.',
              history: msg.history || [],
            }
          );

          return {
            type: MessageType.CHAT_RESPONSE,
            text: response.candidates.content.parts.text,
          };
        }

        // ========== EXÉCUTION DE TÂCHE AGENTIQUE ==========
        case MessageType.EXECUTE_TASK: {
          return await executeTask(msg.task);
        }

        default:
          return { error: `Unknown message type: ${msg.type}` };
      }
    }

    async function executeTask(task: string) {
      const tab = await getActiveTab();
      if (!tab?.id) throw new Error('No active tab');

      const MAX_RETRIES = 3;
      let retryCount = 0;

      while (retryCount < MAX_RETRIES) {
        // 1. Snapshot de la page
        const snapshot: PageSnapshot = await chrome.tabs.sendMessage(
          tab.id!,
          { type: MessageType.GET_SNAPSHOT }
        );

        // 2. Générer le plan (UN SEUL appel LLM)
        let plan: ActionStep[];
        try {
          plan = await planner.generatePlan(task, snapshot);
        } catch (e: any) {
          return { type: MessageType.TASK_COMPLETE, success: false, error: `Planning failed: ${e.message}` };
        }

        // 3. Notifier le sidebar du plan
        broadcastToSidebar({
          type: MessageType.TASK_STEP_UPDATE,
          plan,
          status: 'executing',
        });

        // 4. Exécuter chaque étape
        const results: any[] = [];
        let failed = false;

        for (let i = 0; i < plan.length; i++) {
          const step = plan[i];

          // Gate de confirmation
          if (step.confirm) {
            const confirmed = await requestConfirmation(step);
            if (!confirmed) {
              results.push({ step: step.step, skipped: true, reason: 'User declined' });
              broadcastToSidebar({
                type: MessageType.TASK_STEP_UPDATE,
                currentStep: step.step,
                status: 'skipped',
              });
              continue;
            }
          }

          // Notifier le sidebar
          broadcastToSidebar({
            type: MessageType.TASK_STEP_UPDATE,
            currentStep: step.step,
            status: 'executing',
            reason: step.reason,
          });

          // Exécuter l'action
          const result = await chrome.tabs.sendMessage(tab.id!, {
            type: MessageType.EXECUTE_ACTION,
            action: step,
            elements: snapshot.interactive,
          });

          results.push({ step: step.step, ...result });

          if (!result.success) {
            broadcastToSidebar({
              type: MessageType.TASK_STEP_UPDATE,
              currentStep: step.step,
              status: 'failed',
              error: result.error,
            });
            failed = true;
            break;
          }

          if (result.done) {
            broadcastToSidebar({
              type: MessageType.TASK_STEP_UPDATE,
              currentStep: step.step,
              status: 'done',
              summary: result.summary,
            });
            return {
              type: MessageType.TASK_COMPLETE,
              success: true,
              results,
              summary: result.summary,
            };
          }

          // Délai entre actions pour stabilisation DOM
          await sleep(250);

          // Si la navigation a changé la page, attendre le chargement
          if (step.action === 'click' || step.action === 'navigate') {
            await sleep(500);
            // Vérifier si l'URL a changé (navigation)
            try {
              await chrome.tabs.sendMessage(tab.id!, {
                type: MessageType.GET_SNAPSHOT
              });
            } catch {
              // Content script pas encore injecté dans la nouvelle page
              await sleep(2000);
            }
          }
        }

        if (failed) {
          retryCount++;
          if (retryCount < MAX_RETRIES) {
            broadcastToSidebar({
              type: MessageType.TASK_STEP_UPDATE,
              status: 'replanning',
              retryCount,
            });
            // La boucle while va re-snapshot et re-plan
            await sleep(1000);
            continue;
          }
        }

        return {
          type: MessageType.TASK_COMPLETE,
          success: !failed,
          results,
        };
      }

      return {
        type: MessageType.TASK_COMPLETE,
        success: false,
        error: `Failed after ${MAX_RETRIES} retries`,
      };
    }

    // --- Streaming chat ---

    function handleStreamConnection(port: chrome.runtime.Port) {
      port.onMessage.addListener(async (msg) => {
        if (msg.type === MessageType.STREAM_START) {
          try {
            for await (const chunk of vertex.streamGenerateContent(msg.query, {
              systemInstruction: msg.systemInstruction,
              history: msg.history,
            })) {
              port.postMessage({ type: MessageType.STREAM_CHUNK, text: chunk });
            }
            port.postMessage({ type: MessageType.STREAM_DONE });
          } catch (e: any) {
            port.postMessage({ type: MessageType.STREAM_ERROR, error: e.message });
          }
        }
      });
    }

    // --- Helpers ---

    async function getActiveTab(): Promise<chrome.tabs.Tab | undefined> {
      const [tab] = await chrome.tabs.query({ active: true, currentWindow: true });
      return tab;
    }

    // Communication sidebar via broadcast
    const sidebarPorts = new Set<chrome.runtime.Port>();

    chrome.runtime.onConnect.addListener((port) => {
      if (port.name === 'sidebar') {
        sidebarPorts.add(port);
        port.onDisconnect.addListener(() => sidebarPorts.delete(port));
      }
    });

    function broadcastToSidebar(message: any) {
      for (const port of sidebarPorts) {
        try {
          port.postMessage(message);
        } catch {
          sidebarPorts.delete(port);
        }
      }
    }

    async function requestConfirmation(step: ActionStep): Promise<boolean> {
      return new Promise((resolve) => {
        broadcastToSidebar({
          type: MessageType.TASK_CONFIRM_REQUIRED,
          step,
        });

        // Écouter la réponse du sidebar
        const listener = (msg: any, sender: chrome.runtime.MessageSender) => {
          if (msg.type === MessageType.TASK_CONFIRM_RESPONSE && msg.stepId === step.step) {
            chrome.runtime.onMessage.removeListener(listener);
            resolve(msg.confirmed);
          }
        };
        chrome.runtime.onMessage.addListener(listener);

        // Timeout de 30s
        setTimeout(() => {
          chrome.runtime.onMessage.removeListener(listener);
          resolve(false);
        }, 30000);
      });
    }

    function sleep(ms: number): Promise<void> {
      return new Promise((r) => setTimeout(r, ms));
    }

