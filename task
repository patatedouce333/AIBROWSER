    Task 7.1 : service-worker.js

    JavaScript

    // background/service-worker.js

    import { VertexAIClient } from './vertex-client.js';
    import { ActionPlanner } from './action-planner.js';

    const vertex = new VertexAIClient();
    const planner = new ActionPlanner();

    // Ouvrir le side panel au clic sur l'icône
    chrome.action.onClicked.addListener((tab) => {
      chrome.sidePanel.open({ tabId: tab.id });
    });

    // Router de messages
    chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
      handleMessage(msg, sender).then(sendResponse);
      return true; // async response
    });

    async function handleMessage(msg, sender) {
      switch (msg.type) {

        case 'CHAT_QUERY': {
          // Simple chat avec contexte de page
          const response = await vertex.generateContent(msg.query, {
            systemInstruction:
              'Tu es un assistant de navigation. Réponds en te basant sur le contenu de la page fourni.',
            history: msg.history || [],
          });
          return {
            type: 'CHAT_RESPONSE',
            text: response.candidates.content.parts.text,
          };
        }

        case 'EXECUTE_TASK': {
          // Demander un snapshot au content script
          const [tab] = await chrome.tabs.query({
            active: true, currentWindow: true
          });

          const snapshot = await chrome.tabs.sendMessage(tab.id, {
            type: 'GET_SNAPSHOT'
          });

          // Générer le plan (UN seul appel LLM)
          const plan = await planner.generatePlan(msg.task, snapshot);

          // Exécuter le plan step by step dans le content script
          const results = [];
          for (const step of plan) {
            // Gate de confirmation pour actions irréversibles
            if (step.confirm) {
              // Envoyer au sidebar pour confirmation utilisateur
              // (implémenté via message passing)
              const confirmed = await requestUserConfirmation(step);
              if (!confirmed) {
                results.push({ step: step.step, skipped: true });
                continue;
              }
            }

            const result = await chrome.tabs.sendMessage(tab.id, {
              type: 'EXECUTE_ACTION',
              action: step,
              elements: snapshot.interactive
            });

            results.push({ step: step.step, ...result });

            if (!result.success) {
              // Re-plan avec le nouveau contexte
              const newSnapshot = await chrome.tabs.sendMessage(tab.id, {
                type: 'GET_SNAPSHOT'
              });
              const newPlan = await planner.replan(
                step, result.error,
                plan.slice(plan.indexOf(step) + 1),
                newSnapshot
              );
              // Continuer avec le nouveau plan (récursion contrôlée)
              // ... (implémentation de retry)
              break;
            }

            if (result.done) break;

            // Petit délai entre les actions pour laisser le DOM se stabiliser
            await new Promise(r => setTimeout(r, 200));
          }

          return { type: 'TASK_COMPLETE', results };
        }

        case 'STREAM_CHAT': {
          // Streaming response vers le sidebar
          const port = chrome.runtime.connect({ name: 'stream' });
          for await (const chunk of vertex.streamGenerateContent(msg.query, {
            systemInstruction: msg.systemInstruction,
            history: msg.history,
          })) {
            port.postMessage({ type: 'STREAM_CHUNK', text: chunk });
          }
          port.postMessage({ type: 'STREAM_DONE' });
          return { type: 'STREAM_STARTED' };
        }
      }
    }

