        const selectors = [
          'a[href]', 'button', 'input', 'select', 'textarea',
          '[role="button"]', '[role="link"]', '[role="tab"]',
          '[role="menuitem"]', '[role="checkbox"]', '[role="radio"]',
          '[role="switch"]', '[role="option"]', '[role="combobox"]',
          '[onclick]', '[contenteditable="true"]',
          'summary', '[tabindex]:not([tabindex="-1"])',
        ];

        const allInteractive = document.querySelectorAll(selectors.join(','));
        const seen = new Set<Element>(); // déduplications

        allInteractive.forEach((el) => {
          if (seen.has(el)) return;
          seen.add(el);

          const rect = el.getBoundingClientRect();

          // Filtrer les éléments invisibles/hors-écran
          if (rect.width === 0 && rect.height === 0) return;
          const style = getComputedStyle(el);
          if (style.visibility === 'hidden') return;
          if (style.display === 'none') return;
          if (parseFloat(style.opacity) === 0) return;

          // Vérifier que c'est dans le viewport étendu (viewport + 500px)
          const inExtendedViewport =
            rect.bottom > -500 &&
            rect.top < window.innerHeight + 500 &&
            rect.right > -500 &&
            rect.left < window.innerWidth + 500;

          if (!inExtendedViewport) return;

          const htmlEl = el as HTMLElement;
          const inputEl = el as HTMLInputElement;

          elements.push({
            id: elements.length,
            tag: el.tagName.toLowerCase(),
            type: inputEl.type || null,
            role: el.getAttribute('role') || this.inferRole(el),
            name: this.getAccessibleName(el),
            value: inputEl.value || null,
            href: (el as HTMLAnchorElement).href || null,
            checked: inputEl.checked ?? null,
            disabled: inputEl.disabled ?? false,
            selector: this.generateUniqueSelector(el),
            bbox: {
              x: Math.round(rect.x),
              y: Math.round(rect.y),
              w: Math.round(rect.width),
              h: Math.round(rect.height),
            },
          });
        });

        return elements;
      }

      static extractPageContent(): PageContent {
        const clone = document.cloneNode(true) as Document;

        // Supprimer le bruit
        const noiseSelectors = [
          'script', 'style', 'noscript', 'nav', 'footer',
          'header:not(article header)', 'aside',
          '[role="banner"]', '[role="navigation"]',
          '[role="complementary"]',
          '.ad', '.ads', '.advertisement', '.cookie-banner',
          '[data-ad]', 'iframe', 'svg',
        ];
        for (const sel of noiseSelectors) {
          clone.querySelectorAll(sel).forEach((el) => el.remove());
        }

        const main =
          clone.querySelector('main, [role="main"], article, .content, #content') ||
          clone.body;

        return {
          title: document.title,
          url: window.location.href,
          text: (main?.textContent || '')
            .replace(/\s+/g, ' ')      // normaliser les espaces
            .trim()
            .slice(0, 15000),           // ~4k tokens max
          structuredData: this.extractStructuredData(),
          meta: this.extractMeta(),
        };
      }

      static getViewport(): ViewportInfo {
        return {
          width: window.innerWidth,
          height: window.innerHeight,
          scrollY: Math.round(window.scrollY),
          totalHeight: document.documentElement.scrollHeight,
        };
      }

      /**
       * Version compacte pour le LLM — réduit drastiquement les tokens
       */
      static compactInteractiveList(): string {
        const elements = this.extractInteractiveElements();
        return elements
          .map((el) => {
            const parts = [`[${el.id}]`, el.role];
            if (el.name) parts.push(`"${el.name}"`);
            if (el.value) parts.push(`val="${el.value}"`);
            if (el.href) {
              // Tronquer les URLs longues
              const shortHref = el.href.length > 60
                ? el.href.slice(0, 57) + '...'
                : el.href;
              parts.push(`→${shortHref}`);
            }
            if (el.disabled) parts.push('[disabled]');
            return parts.join(' ');
          })
          .join('\n');
      }

      // --- Méthodes privées ---

      private static getAccessibleName(el: Element): string {
        // Priority: aria-label > aria-labelledby > title > alt > placeholder > text
        const label = el.getAttribute('aria-label');
        if (label) return label;

        const labelledBy = el.getAttribute('aria-labelledby');
        if (labelledBy) {
          const labelEl = document.getElementById(labelledBy);
          if (labelEl) return labelEl.textContent?.trim() || '';
        }

        const title = el.getAttribute('title');
        if (title) return title;

        const alt = el.getAttribute('alt');
        if (alt) return alt;

        const placeholder = (el as HTMLInputElement).placeholder;
        if (placeholder) return placeholder;

        // Texte direct, tronqué
        return (el.textContent || '').trim().slice(0, 80);
      }

      private static inferRole(el: Element): string {
        const tag = el.tagName.toLowerCase();
        const type = (el as HTMLInputElement).type;
        const map: Record<string, string> = {
          a: 'link',
          button: 'button',
          select: 'combobox',
          textarea: 'textbox',
          summary: 'disclosure',
        };
        if (tag === 'input') return `input-${type || 'text'}`;
        return map[tag] || tag;
      }

      private static generateUniqueSelector(el: Element): string {
        // Priority: id > data-testid > generated path
        if (el.id) return `#${CSS.escape(el.id)}`;

        const testId = el.getAttribute('data-testid');
        if (testId) return `[data-testid="${CSS.escape(testId)}"]`;

        const ariaLabel = el.getAttribute('aria-label');
        if (ariaLabel) {
          const tag = el.tagName.toLowerCase();
          return `${tag}[aria-label="${CSS.escape(ariaLabel)}"]`;
        }

        // Fallback: path-based selector
        const path: string[] = [];
        let current: Element | null = el;
        while (current && current !== document.body && path.length < 5) {
          let seg = current.tagName.toLowerCase();
          if (current.id) {
            path.unshift(`#${CSS.escape(current.id)}`);
            break;
          }
          const parent = current.parentElement;
          if (parent) {
            const siblings = Array.from(parent.children).filter(
              (s) => s.tagName === current!.tagName
            );
            if (siblings.length > 1) {
              const idx = siblings.indexOf(current) + 1;
              seg += `:nth-of-type(${idx})`;
            }
          }
          path.unshift(seg);
          current = parent;
        }
        return path.join(' > ');
      }

      private static extractStructuredData(): any[] {
        const results: any[] = [];
        document
          .querySelectorAll('script[type="application/ld+json"]')
          .forEach((el) => {
            try {
              results.push(JSON.parse(el.textContent || ''));
            } catch { /* ignorer les JSON invalides */ }
          });
        return results;
      }

      private static extractMeta(): Record<string, string> {
        const meta: Record<string, string> = {};
        document.querySelectorAll('meta[property], meta[name]').forEach((el) => {
          const key = el.getAttribute('property') || el.getAttribute('name');
          const content = el.getAttribute('content');
          if (key && content) meta[key] = content;
        });
        return meta;
      }
    }

