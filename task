    Blocage critique #1 : Le Service Worker MV3 meurt après 30 secondes d'inactivité

    C'est le problème le plus sous-estimé. Chrome tue le service worker après ~30s sans événement. Or une tâche agentique peut durer 30s à 2min.
    Solution : Keep-alive + offscreen document

    TypeScript

    // src/background/keep-alive.ts

    /**
     * Le service worker MV3 est tué après 30s d'inactivité.
     * Pour les tâches longues (execution agentique), il faut le maintenir en vie.
     *
     * Stratégie combinée :
     * 1. chrome.alarms (minimum 30s mais empêche la terminaison)
     * 2. Port ouvert avec le sidebar (tant que le sidebar est ouvert)
     * 3. Offscreen document pour les tâches très longues
     */

    let keepAliveInterval: ReturnType<typeof setInterval> | null = null;
    let activePorts = new Set<chrome.runtime.Port>();

    export function startKeepAlive() {
      // Méthode 1 : Alarm toutes les 25 secondes
      chrome.alarms.create('keep-alive', { periodInMinutes: 0.4 });

      // Méthode 2 : Self-messaging (plus fiable que les alarms)
      if (!keepAliveInterval) {
        keepAliveInterval = setInterval(() => {
          chrome.runtime.getPlatformInfo(() => {
            // Le callback suffit à garder le SW en vie
          });
        }, 25000);
      }
    }

    export function stopKeepAlive() {
      chrome.alarms.clear('keep-alive');
      if (keepAliveInterval) {
        clearInterval(keepAliveInterval);
        keepAliveInterval = null;
      }
    }

    // Méthode 3 : Port persistant avec le sidebar
    export function registerPort(port: chrome.runtime.Port) {
      activePorts.add(port);
      port.onDisconnect.addListener(() => {
        activePorts.delete(port);
        if (activePorts.size === 0) {
          // Plus aucun port → on peut laisser le SW mourir
          // SAUF si une tâche est en cours
        }
      });
    }

    // Listener d'alarm
    chrome.alarms.onAlarm.addListener((alarm) => {
      if (alarm.name === 'keep-alive') {
        // No-op, juste garder le SW en vie
      }
    });

