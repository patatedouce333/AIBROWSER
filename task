    // src/background/action-planner.ts

    import { VertexAIClient } from './vertex-client';
    import { ActionStep, PageSnapshot } from '../shared/messages';

    const PLANNING_SYSTEM_PROMPT = `Tu es un agent de navigation web expert.
    Tu reçois un snapshot de page (éléments interactifs + contenu) et une tâche.
    Tu DOIS générer un PLAN COMPLET d'actions en UNE SEULE réponse.

    ÉLÉMENTS INTERACTIFS :
    Chaque ligne : [id] role "nom accessible" val="valeur" →href [disabled]
    Utilise l'id numérique pour référencer un élément.

    TYPES D'ACTIONS DISPONIBLES :
    - click: cliquer sur un élément. Params: element_id OU selector
    - type: saisir du texte. Params: element_id, text
    - select: choisir une option. Params: element_id, value
    - scroll: défiler. Params: direction ("up"|"down")
    - wait: attendre un élément. Params: condition ("selector_visible"), selector, timeout_ms
    - press_key: appuyer sur une touche. Params: key ("Enter", "Escape", "Tab", etc.)
    - navigate: aller à une URL. Params: url
    - done: tâche terminée. Params: summary

    RÈGLES :
    1. Génère TOUTES les étapes, pas une seule
    2. Après un type dans un champ de recherche, ajoute souvent press_key "Enter" ou click sur le bouton submit
    3. Après un click de navigation, ajoute un wait pour le chargement
    4. Pour les actions à conséquences (achat, envoi email, suppression), mets "confirm": true
    5. Si un élément n'est pas visible, scroll d'abord
    6. Maximum 20 étapes par plan

    RÉPONSE : JSON array strict, aucun texte autour.`;

    export class ActionPlanner {
      private vertex = new VertexAIClient();

      async generatePlan(
        task: string,
        snapshot: PageSnapshot
      ): Promise<ActionStep[]> {
        // Utiliser la version compacte des éléments interactifs
        // pour minimiser les tokens (= minimiser la latence)
        const compactElements = snapshot.interactive
          .map((el) => {
            const parts = [`[${el.id}]`, el.role];
            if (el.name) parts.push(`"${el.name}"`);
            if (el.value) parts.push(`val="${el.value}"`);
            if (el.href) {
              const short = el.href.length > 60
                ? el.href.slice(0, 57) + '...'
                : el.href;
              parts.push(`→${short}`);
            }
            if (el.disabled) parts.push('[disabled]');
            return parts.join(' ');
          })
          .join('\n');

        const userPrompt = `TÂCHE: ${task}

    PAGE: ${snapshot.content.url}
    TITRE: ${snapshot.content.title}
    VIEWPORT: ${snapshot.viewport.width}x${snapshot.viewport.height}, scroll=${snapshot.viewport.scrollY}/${snapshot.viewport.totalHeight}

    ÉLÉMENTS INTERACTIFS (${snapshot.interactive.length}) :
    ${compactElements}

    CONTENU (extrait) :
    ${snapshot.content.text.slice(0, 2000)}`;

        const response = await this.vertex.generateContent(userPrompt, {
          systemInstruction: PLANNING_SYSTEM_PROMPT,
          temperature: 0.1,
          jsonMode: true,
          model: 'gemini-2.0-flash', // flash pour la vitesse du planning
          maxTokens: 4096,
        });

        const text = response.candidates.content.parts.text;

        try {
          const plan: ActionStep[] = JSON.parse(text);

          // Validation basique du plan
          for (const step of plan) {
            if (!step.action) throw new Error(`Step ${step.step} missing action`);
            if (!step.reason) step.reason = '';
          }

          return plan;
        } catch (parseError) {
          // Fallback : essayer d'extraire le JSON du texte
          const jsonMatch = text.match(/\[[\s\S]*\]/);
          if (jsonMatch) {
            return JSON.parse(jsonMatch);
          }
          throw new Error(`Failed to parse plan: ${text.slice(0, 200)}`);
        }
      }

      async replan(
        failedStep: ActionStep,
        error: string,
        newSnapshot: PageSnapshot
      ): Promise<ActionStep[]> {
        const task =
          `L'étape précédente a échoué: action="${failedStep.action}" ` +
          `reason="${failedStep.reason}" error="${error}". ` +
          `Analyse le nouveau snapshot et génère un plan alternatif.`;

        return this.generatePlan(task, newSnapshot);
      }
    }

