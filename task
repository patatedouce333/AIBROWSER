    // content/dom-extractor.js

    export class DOMExtractor {
      /**
       * Extraction sémantique compacte — ce qui remplace le screenshot
       * Retourne une représentation textuelle légère du DOM interactif
       */
      static extractInteractiveElements() {
        const elements = [];
        const interactiveSelectors = [
          'a[href]', 'button', 'input', 'select', 'textarea',
          '[role="button"]', '[role="link"]', '[role="tab"]',
          '[role="menuitem"]', '[role="checkbox"]', '[role="radio"]',
          '[onclick]', '[contenteditable="true"]',
          'summary', 'details', '[tabindex]'
        ];

        const allInteractive = document.querySelectorAll(
          interactiveSelectors.join(',')
        );

        allInteractive.forEach((el, index) => {
          const rect = el.getBoundingClientRect();
          // Ignorer les éléments hors viewport ou invisibles
          if (rect.width === 0 || rect.height === 0) return;
          if (getComputedStyle(el).visibility === 'hidden') return;
          if (getComputedStyle(el).display === 'none') return;

          elements.push({
            id: index,
            tag: el.tagName.toLowerCase(),
            type: el.type || null,
            role: el.getAttribute('role') || this.#inferRole(el),
            name: this.#getAccessibleName(el),
            value: el.value || null,
            href: el.href || null,
            checked: el.checked ?? null,
            disabled: el.disabled ?? false,
            // Sélecteur CSS unique pour re-cibler l'élément
            selector: this.#generateUniqueSelector(el),
            // Bounding box pour fallback vision
            bbox: {
              x: Math.round(rect.x),
              y: Math.round(rect.y),
              w: Math.round(rect.width),
              h: Math.round(rect.height)
            }
          });
        });

        return elements;
      }

      /**
       * Extraction du contenu textuel principal (Readability-like)
       */
      static extractPageContent() {
        // Clone le DOM pour ne pas modifier la page
        const clone = document.cloneNode(true);

        // Supprimer le bruit
        const noiseSelectors = [
          'script', 'style', 'noscript', 'nav', 'footer',
          'header', 'aside', '[role="banner"]', '[role="navigation"]',
          '[role="complementary"]', '.ad', '.ads', '.advertisement',
          '[data-ad]', 'iframe'
        ];
        noiseSelectors.forEach(sel => {
          clone.querySelectorAll(sel).forEach(el => el.remove());
        });

        // Extraire le contenu principal
        const main = clone.querySelector('main, [role="main"], article, .content, #content')
          || clone.body;

        return {
          title: document.title,
          url: window.location.href,
          text: main?.innerText?.slice(0, 15000) || '', // cap à ~4k tokens
          structuredData: this.#extractStructuredData(),
          meta: this.#extractMeta()
        };
      }

      /**
       * Snapshot complet pour le LLM (combiné)
       */
      static fullSnapshot() {
        return {
          interactive: this.extractInteractiveElements(),
          content: this.extractPageContent(),
          viewport: {
            width: window.innerWidth,
            height: window.innerHeight,
            scrollY: window.scrollY,
            totalHeight: document.documentElement.scrollHeight
          }
        };
      }

      // --- Helpers privés ---

      static #getAccessibleName(el) {
        return (
          el.getAttribute('aria-label') ||
          el.getAttribute('aria-labelledby') &&
            document.getElementById(el.getAttribute('aria-labelledby'))?.textContent ||
          el.getAttribute('title') ||
          el.getAttribute('alt') ||
          el.getAttribute('placeholder') ||
          el.textContent?.trim().slice(0, 80) ||
          ''
        );
      }

      static #inferRole(el) {
        const tag = el.tagName.toLowerCase();
        const roleMap = {
          a: 'link', button: 'button', input: `input-${el.type || 'text'}`,
          select: 'combobox', textarea: 'textbox'
        };
        return roleMap[tag] || tag;
      }

      static #generateUniqueSelector(el) {
        if (el.id) return `#${CSS.escape(el.id)}`;

        const path = [];
        let current = el;
        while (current && current !== document.body) {
          let selector = current.tagName.toLowerCase();
          if (current.id) {
            path.unshift(`#${CSS.escape(current.id)}`);
            break;
          }
          const siblings = current.parentElement?.children;
          if (siblings && siblings.length > 1) {
            const index = Array.from(siblings)
              .filter(s => s.tagName === current.tagName)
              .indexOf(current);
            if (index > 0) selector += `:nth-of-type(${index + 1})`;
          }
          path.unshift(selector);
          current = current.parentElement;
        }
        return path.join(' > ');
      }

      static #extractStructuredData() {
        const jsonLd = [];
        document.querySelectorAll('script[type="application/ld+json"]')
          .forEach(el => {
            try { jsonLd.push(JSON.parse(el.textContent)); } catch {}
          });
        return jsonLd;
      }

      static #extractMeta() {
        const meta = {};
        document.querySelectorAll('meta[property], meta[name]').forEach(el => {
          const key = el.getAttribute('property') || el.getAttribute('name');
          if (key) meta[key] = el.content;
        });
        return meta;
      }
    }

