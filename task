    Option C : Architecture hybride optimale

    TypeScript

    class FastBrowserAgent {
      // 1. Un seul appel LLM pour le plan complet
      async planActions(task: string, page: Page): Promise<Action[]> {
        const a11yTree = await this.getCompactA11yTree(page);
        const domSummary = await this.getSemanticDOM(page);

        // Envoie texte, PAS image
        return await this.llm.generatePlan(task, a11yTree, domSummary);
      }

      // 2. Exécution rapide sans LLM dans la loop
      async executePlan(plan: Action[], page: Page): Promise<void> {
        for (const action of plan) {
          await this.executeAction(action, page);

          // Vérification rapide (DOM check, pas screenshot)
          const success = await this.quickVerify(action, page);

          if (!success) {
            // SEULEMENT en cas d'échec : re-plan avec contexte mis à jour
            const remainingPlan = await this.replan(action, page);
            return this.executePlan(remainingPlan, page);
          }
        }
      }

      // 3. A11y tree compacté (réduire les tokens envoyés au LLM)
      async getCompactA11yTree(page: Page): Promise<string> {
        const full = await page.accessibility.snapshot();
        // Filtre : garder uniquement les éléments interactifs
        return this.filterInteractiveNodes(full);
      }

      // 4. Fallback vision UNIQUEMENT si le DOM est inutilisable
      async fallbackVision(page: Page, task: string): Promise<Action[]> {
        const screenshot = await page.screenshot({ type: 'jpeg', quality: 50 });
        // Quality basse = transfert plus rapide, suffisant pour la vision
        return await this.visionModel.analyze(screenshot, task);
      }
    }

