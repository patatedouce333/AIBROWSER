    // src/content/index.ts

    import { DOMExtractor } from './dom-extractor';
    import { ActionExecutor } from './action-executor';
    import { MessageType } from '../shared/messages';

    // Listener principal
    chrome.runtime.onMessage.addListener((msg, _sender, sendResponse) => {
      handle(msg).then(sendResponse).catch((e) => sendResponse({ error: e.message }));
      return true;
    });

    async function handle(msg: any) {
      switch (msg.type) {
        case MessageType.GET_SNAPSHOT:
          return DOMExtractor.fullSnapshot();

        case MessageType.EXECUTE_ACTION:
          return ActionExecutor.execute(msg.action, msg.elements);

        case 'GET_SELECTED_TEXT':
          return { text: window.getSelection()?.toString() || '' };

        default:
          return { error: `Unknown content message: ${msg.type}` };
      }
    }

    // Optionnel : MutationObserver pour détecter les changements DOM
    // et notifier le background si nécessaire
    const observer = new MutationObserver((mutations) => {
      // Debounce : ne pas spammer le background
      // Utile pour la re-planification en cas de page dynamique
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: false,
    });

