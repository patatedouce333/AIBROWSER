    Blocage critique #2 : Content script non injecté après navigation

    Quand l'agent clique un lien et que la page change, le content script de l'ancienne page est détruit. Le nouveau content script met du temps à s'injecter (document_idle).
    Solution : Injection programmatique + attente

    TypeScript

    // src/background/tab-manager.ts

    export class TabManager {
      /**
       * Garantit que le content script est prêt dans un tab donné.
       * Gère le cas de navigation inter-page.
       */
      static async ensureContentScript(tabId: number): Promise<void> {
        const MAX_WAIT = 10000;
        const POLL = 200;
        const start = Date.now();

        while (Date.now() - start < MAX_WAIT) {
          try {
            // Tenter de communiquer avec le content script
            const response = await chrome.tabs.sendMessage(tabId, {
              type: 'PING',
            });
            if (response?.pong) return;
          } catch {
            // Content script pas encore prêt — injecter manuellement
            try {
              await chrome.scripting.executeScript({
                target: { tabId },
                files: ['content/index.js'],
              });
              // Attendre que le script s'initialise
              await sleep(100);
              continue;
            } catch (injectError: any) {
              // Page pas encore chargée ou chrome:// URL
              if (injectError.message?.includes('Cannot access')) {
                // Page protégée (chrome://, about:, etc.)
                throw new Error(`Cannot inject into this page`);
              }
            }
          }
          await sleep(POLL);
        }

        throw new Error(`Content script not ready after ${MAX_WAIT}ms`);
      }

      /**
       * Attend qu'une navigation soit complète dans un tab
       */
      static async waitForNavigation(
        tabId: number,
        timeoutMs = 15000
      ): Promise<void> {
        return new Promise((resolve, reject) => {
          const timeout = setTimeout(() => {
            chrome.tabs.onUpdated.removeListener(listener);
            reject(new Error('Navigation timeout'));
          }, timeoutMs);

          const listener = (
            updatedTabId: number,
            changeInfo: chrome.tabs.TabChangeInfo
          ) => {
            if (updatedTabId === tabId && changeInfo.status === 'complete') {
              clearTimeout(timeout);
              chrome.tabs.onUpdated.removeListener(listener);
              // Petit délai additionnel pour laisser les scripts de la page s'exécuter
              setTimeout(resolve, 300);
            }
          };

          chrome.tabs.onUpdated.addListener(listener);
        });
      }

      /**
       * Détecte si un click a provoqué une navigation
       */
      static async detectNavigation(
        tabId: number,
        action: () => Promise<any>,
        timeoutMs = 3000
      ): Promise<{ navigated: boolean; newUrl?: string }> {
        const tabBefore = await chrome.tabs.get(tabId);
        const urlBefore = tabBefore.url;

        let navigated = false;
        let newUrl: string | undefined;

        const navigationPromise = new Promise<void>((resolve) => {
          const listener = (
            updatedTabId: number,
            changeInfo: chrome.tabs.TabChangeInfo,
            tab: chrome.tabs.Tab
          ) => {
            if (updatedTabId === tabId && changeInfo.url && changeInfo.url !== urlBefore) {
              navigated = true;
              newUrl = changeInfo.url;
              chrome.tabs.onUpdated.removeListener(listener);
              resolve();
            }
          };
          chrome.tabs.onUpdated.addListener(listener);

          // Timeout si pas de navigation
          setTimeout(() => {
            chrome.tabs.onUpdated.removeListener(listener);
            resolve();
          }, timeoutMs);
        });

        // Exécuter l'action
        await action();

        // Attendre un peu pour voir si ça navigue
        await navigationPromise;

        return { navigated, newUrl };
      }
    }

    function sleep(ms: number): Promise<void> {
      return new Promise((r) => setTimeout(r, ms));
    }

    Blocage critique #3 : Les sites SPA (React/Angular/Vue) ne triggent pas de load event

    Les Single Page Applications changent de "page" sans navigation réelle. Le DOM mute mais il n'y a pas de tabs.onUpdated avec status: 'complete'.
    Solution : MutationObserver intelligent dans le content script

    TypeScript

    // src/content/mutation-watcher.ts

    export class MutationWatcher {
      private observer: MutationObserver | null = null;
      private debounceTimer: ReturnType<typeof setTimeout> | null = null;
      private lastUrl = window.location.href;
      private mutationCount = 0;
      private significantChangeCallback: (() => void) | null = null;

      start(onSignificantChange: () => void) {
        this.significantChangeCallback = onSignificantChange;
        this.lastUrl = window.location.href;

        // Observer les changements de DOM
        this.observer = new MutationObserver((mutations) => {
          this.handleMutations(mutations);
        });

        this.observer.observe(document.body, {
          childList: true,
          subtree: true,
          characterData: false,
          attributes: false,
        });

        // Observer les changements d'URL (History API pour SPA)
        this.patchHistoryAPI();
      }

      stop() {
        this.observer?.disconnect();
        this.observer = null;
      }

      private handleMutations(mutations: MutationRecord[]) {
        // Compter les nodes ajoutés significatifs (pas les textes, pas les micro-updates)
        let significantAdded = 0;
        for (const mutation of mutations) {
          for (const node of mutation.addedNodes) {
            if (node.nodeType === Node.ELEMENT_NODE) {
              const el = node as HTMLElement;
              // Ignorer les éléments trivaux
              if (el.tagName === 'SCRIPT' || el.tagName === 'STYLE') continue;
              if (el.tagName === 'SPAN' && !el.children.length) continue;
              significantAdded++;
            }
          }
        }

        this.mutationCount += significantAdded;

        // Debounce : attendre que le DOM se stabilise
        if (this.debounceTimer) clearTimeout(this.debounceTimer);
        this.debounceTimer = setTimeout(() => {
          if (this.mutationCount > 10) {
            // Changement significatif détecté
            this.mutationCount = 0;
            this.significantChangeCallback?.();
          }
          this.mutationCount = 0;
        }, 500);
      }

      /**
       * Patch pushState/replaceState pour détecter la navigation SPA
       */
      private patchHistoryAPI() {
        const originalPushState = history.pushState;
        const originalReplaceState = history.replaceState;
        const self = this;

        history.pushState = function (...args) {
          originalPushState.apply(this, args);
          self.checkUrlChange();
        };

        history.replaceState = function (...args) {
          originalReplaceState.apply(this, args);
          self.checkUrlChange();
        };

        // popstate pour back/forward
        window.addEventListener('popstate', () => this.checkUrlChange());
      }

      private checkUrlChange() {
        const currentUrl = window.location.href;
        if (currentUrl !== this.lastUrl) {
          this.lastUrl = currentUrl;
          // Notifier le background qu'on a "navigué" (SPA)
          chrome.runtime.sendMessage({
            type: 'SPA_NAVIGATION',
            url: currentUrl,
          });
          // Aussi trigger le callback de changement significatif
          // avec un délai pour laisser le nouveau contenu se charger
          setTimeout(() => {
            this.significantChangeCallback?.();
          }, 800);
        }
      }
    }

    Blocage critique #4 : Sites avec Content Security Policy restrictive

    Certains sites (banques, Google Workspace, etc.) ont une CSP qui bloque les event dispatchers ou les injections.
    Solution : Exécution dans le "main world" au lieu de l'isolated world

    TypeScript

    // src/background/execute-in-main-world.ts

    /**
     * Par défaut, les content scripts tournent dans un "isolated world"
     * qui a accès au DOM mais PAS aux variables JS de la page.
     *
     * Pour les sites avec frameworks réactifs (React, Vue, Angular),
     * il faut parfois exécuter dans le "main world" pour :
     * - Accéder aux instances React/Vue
     * - Trigger les bons event handlers
     * - Bypass certaines protections CSP
     */
    export async function executeInMainWorld(
      tabId: number,
      func: (...args: any[]) => any,
      args: any[] = []
    ): Promise<any> {
      const results = await chrome.scripting.executeScript({
        target: { tabId },
        func,
        args,
        world: 'MAIN', // ← le truc critique
      });

      return results?.?.result;
    }

    // Exemple d'usage pour React controlled inputs :
    export async function setReactInputValue(
      tabId: number,
      selector: string,
      value: string
    ): Promise<void> {
      await executeInMainWorld(
        tabId,
        (sel: string, val: string) => {
          const el = document.querySelector(sel) as HTMLInputElement;
          if (!el) throw new Error(`Element not found: ${sel}`);

          // Obtenir le setter natif (bypass React controlled component)
          const nativeInputValueSetter = Object.getOwnPropertyDescriptor(
            window.HTMLInputElement.prototype,
            'value'
          )!.set!;

          nativeInputValueSetter.call(el, val);

          // Dispatcher l'event que React écoute
          el.dispatchEvent(new Event('input', { bubbles: true }));
          el.dispatchEvent(new Event('change', { bubbles: true }));
        },
        [selector, value]
      );
    }

    Blocage critique #5 : Le token OAuth2 dans le client secret expose une vulnérabilité

    Stocker le client_secret dans le code de l'extension est techniquement acceptable pour les apps publiques (Google le documente), mais pas idéal pour une org avec des politiques de sécurité strictes.
    Solution : PKCE flow (Proof Key for Code Exchange) — pas besoin de client_secret

    TypeScript

    // src/background/auth-manager-pkce.ts

    /**
     * OAuth2 avec PKCE — élimine le besoin de client_secret
     * Recommandé par Google pour les applications publiques (extensions, mobile)
     *
     * RFC 7636 : https://tools.ietf.org/html/rfc7636
     */

    const OAUTH_CONFIG = {
      clientId: 'VOTRE_CLIENT_ID.apps.googleusercontent.com',
      // PAS de client_secret nécessaire avec PKCE
      redirectUri: `https://${chrome.runtime.id}.chromiumapp.org/`,
      authEndpoint: 'https://accounts.google.com/o/oauth2/v2/auth',
      tokenEndpoint: 'https://oauth2.googleapis.com/token',
      scope: 'https://www.googleapis.com/auth/cloud-platform',
    };

    export class AuthManagerPKCE {

      async login(): Promise<string> {
        // 1. Générer le code_verifier (random 43-128 chars)
        const codeVerifier = this.generateCodeVerifier();

        // 2. Calculer le code_challenge (SHA256 du verifier, base64url)
        const codeChallenge = await this.generateCodeChallenge(codeVerifier);

        // 3. State anti-CSRF
        const state = crypto.randomUUID();

        // 4. Construire l'URL d'auth avec PKCE params
        const authUrl = new URL(OAUTH_CONFIG.authEndpoint);
        authUrl.searchParams.set('client_id', OAUTH_CONFIG.clientId);
        authUrl.searchParams.set('redirect_uri', OAUTH_CONFIG.redirectUri);
        authUrl.searchParams.set('response_type', 'code');
        authUrl.searchParams.set('scope', OAUTH_CONFIG.scope);
        authUrl.searchParams.set('state', state);
        authUrl.searchParams.set('access_type', 'offline');
        authUrl.searchParams.set('prompt', 'consent');
        // ← PKCE params
        authUrl.searchParams.set('code_challenge', codeChallenge);
        authUrl.searchParams.set('code_challenge_method', 'S256');

        // 5. Lancer le flow
        const responseUrl = await chrome.identity.launchWebAuthFlow({
          url: authUrl.toString(),
          interactive: true,
        });

        // 6. Extraire le code
        const url = new URL(responseUrl);
        const code = url.searchParams.get('code');
        const returnedState = url.searchParams.get('state');

        if (returnedState !== state) throw new Error('State mismatch');
        if (!code) throw new Error(`Auth error: ${url.searchParams.get('error')}`);

        // 7. Échanger code → tokens AVEC le code_verifier (pas de client_secret)
        const response = await fetch(OAUTH_CONFIG.tokenEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            code,
            client_id: OAUTH_CONFIG.clientId,
            redirect_uri: OAUTH_CONFIG.redirectUri,
            grant_type: 'authorization_code',
            code_verifier: codeVerifier, // ← preuve PKCE, remplace le client_secret
          }),
        });

        if (!response.ok) {
          throw new Error(`Token exchange failed: ${await response.text()}`);
        }

        const tokens = await response.json();

        await TokenStore.save({
          accessToken: tokens.access_token,
          refreshToken: tokens.refresh_token,
          expiresAt: Date.now() + tokens.expires_in * 1000,
          scope: tokens.scope,
        });

        return tokens.access_token;
      }

      async refreshToken(refreshToken: string): Promise<string> {
        // Le refresh ne nécessite PAS le code_verifier, juste le client_id
        const response = await fetch(OAUTH_CONFIG.tokenEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            refresh_token: refreshToken,
            client_id: OAUTH_CONFIG.clientId,
            // PAS de client_secret
            grant_type: 'refresh_token',
          }),
        });

        if (!response.ok) throw new Error('Refresh failed');

        const data = await response.json();

        await TokenStore.save({
          accessToken: data.access_token,
          refreshToken: refreshToken,
          expiresAt: Date.now() + data.expires_in * 1000,
          scope: data.scope,
        });

        return data.access_token;
      }

      // --- Crypto helpers pour PKCE ---

      private generateCodeVerifier(): string {
        // 32 bytes → 43 chars en base64url
        const array = new Uint8Array(32);
        crypto.getRandomValues(array);
        return this.base64urlEncode(array);
      }

      private async generateCodeChallenge(verifier: string): Promise<string> {
        const encoder = new TextEncoder();
        const data = encoder.encode(verifier);
        const digest = await crypto.subtle.digest('SHA-256', data);
        return this.base64urlEncode(new Uint8Array(digest));
      }

      private base64urlEncode(buffer: Uint8Array): string {
        let str = '';
        for (const byte of buffer) {
          str += String.fromCharCode(byte);
        }
        return btoa(str)
          .replace(/\+/g, '-')
          .replace(/\//g, '_')
          .replace(/=+$/, '');
      }
    }

    Blocage critique #6 : Rate limiting Vertex AI et gestion des quotas

    Vertex AI a des quotas par défaut de 60 requests/min pour Gemini Flash et 5 requests/min pour Gemini Pro. Un usage agentique peut facilement dépasser ça.
    Solution : Request queue avec backpressure et retry intelligent

    TypeScript

    // src/background/request-queue.ts

    interface QueuedRequest {
      id: string;
      execute: () => Promise<any>;
      resolve: (value: any) => void;
      reject: (error: any) => void;
      priority: number; // 0 = highest
      retryCount: number;
      maxRetries: number;
    }

    export class RequestQueue {
      private queue: QueuedRequest[] = [];
      private processing = false;
      private requestsThisMinute = 0;
      private minuteStart = Date.now();
      private readonly maxPerMinute: number;
      private readonly minDelayMs: number;

      constructor(options: { maxPerMinute?: number; minDelayMs?: number } = {}) {
        this.maxPerMinute = options.maxPerMinute || 55; // marge de sécurité vs quota 60
        this.minDelayMs = options.minDelayMs || 1000;
      }

      async enqueue<T>(
        execute: () => Promise<T>,
        options: { priority?: number; maxRetries?: number } = {}
      ): Promise<T> {
        return new Promise((resolve, reject) => {
          const request: QueuedRequest = {
            id: crypto.randomUUID(),
            execute,
            resolve,
            reject,
            priority: options.priority ?? 5,
            retryCount: 0,
            maxRetries: options.maxRetries ?? 3,
          };

          // Insérer en respectant la priorité
          const insertIdx = this.queue.findIndex((r) => r.priority > request.priority);
          if (insertIdx === -1) {
            this.queue.push(request);
          } else {
            this.queue.splice(insertIdx, 0, request);
          }

          this.processNext();
        });
      }

      private async processNext() {
        if (this.processing || this.queue.length === 0) return;
        this.processing = true;

        while (this.queue.length > 0) {
          // Vérifier le rate limit
          await this.waitForSlot();

          const request = this.queue.shift()!;

          try {
            const result = await request.execute();
            request.resolve(result);
          } catch (error: any) {
            if (this.isRetryable(error) && request.retryCount < request.maxRetries) {
              // Re-enqueue avec backoff
              request.retryCount++;
              const backoff = Math.min(
                1000 * Math.pow(2, request.retryCount), // exponential
                30000 // max 30s
              );
              await this.sleep(backoff);
              this.queue.unshift(request); // remettre en tête
            } else {
              request.reject(error);
            }
          }
        }

        this.processing = false;
      }

      private async waitForSlot() {
        const now = Date.now();

        // Reset le compteur toutes les minutes
        if (now - this.minuteStart > 60000) {
          this.requestsThisMinute = 0;
          this.minuteStart = now;
        }

        // Si on a atteint le quota, attendre
        if (this.requestsThisMinute >= this.maxPerMinute) {
          const waitTime = 60000 - (now - this.minuteStart) + 100;
          await this.sleep(waitTime);
          this.requestsThisMinute = 0;
          this.minuteStart = Date.now();
        }

        // Délai minimum entre requêtes
        await this.sleep(this.minDelayMs);
        this.requestsThisMinute++;
      }

      private isRetryable(error: any): boolean {
        const message = error.message || '';
        // 429 = rate limited, 503 = service unavailable, 500 = server error
        return (
          message.includes('429') ||
          message.includes('503') ||
          message.includes('500') ||
          message.includes('RESOURCE_EXHAUSTED') ||
          message.includes('timeout')
        );
      }

      private sleep(ms: number): Promise<void> {
        return new Promise((r) => setTimeout(r, ms));
      }
    }

    Blocage critique #7 : Le contexte dépasse la context window du modèle

    Un snapshot de page avec 150 éléments interactifs + 3000 chars de contenu + l'historique de conversation + le system prompt peut facilement dépasser la context window.
    Solution : Compression de contexte intelligente

    TypeScript

    // src/background/context-manager.ts

    export class ContextManager {
      // Limites approximatives en tokens (1 token ≈ 4 chars en anglais, ~3 en français)
      private static readonly MODEL_LIMITS: Record<string, number> = {
        'gemini-2.0-flash': 1048576, // 1M tokens
        'gemini-2.5-pro': 1048576,
        'gemini-2.5-flash': 1048576,
      };

      // Budget de tokens par section
      private static readonly BUDGET = {
        systemPrompt: 800,
        history: 4000,
        interactiveElements: 3000,
        pageContent: 2000,
        task: 200,
        // Total: ~10k tokens pour un plan d'action
        // Bien en dessous de la limite, mais on minimise pour la VITESSE
        // Plus de tokens = plus de latence d'inférence
      };

      /**
       * Compresse le snapshot pour tenir dans le budget de tokens
       * tout en maximisant la pertinence
       */
      static compressForPlanning(
        task: string,
        snapshot: PageSnapshot,
        history: Array<{ role: string; content: string }>
      ): string {
        // 1. Filtrer les éléments interactifs pertinents
        const relevantElements = this.filterRelevantElements(
          task,
          snapshot.interactive
        );

        // 2. Tronquer l'historique (garder les N derniers échanges)
        const recentHistory = history.slice(-4);

        // 3. Extraire uniquement le contenu pertinent de la page
        const relevantContent = this.extractRelevantContent(
          task,
          snapshot.content.text
        );

        // 4. Construire le prompt compact
        const compactElements = relevantElements
          .map((el) => {
            const parts = [`[${el.id}]`, el.role];
            if (el.name) parts.push(`"${el.name.slice(0, 40)}"`);
            if (el.value) parts.push(`val="${el.value.slice(0, 20)}"`);
            if (el.href) {
              const domain = new URL(el.href).pathname.slice(0, 30);
              parts.push(`→${domain}`);
            }
            if (el.disabled) parts.push('[disabled]');
            return parts.join(' ');
          })
          .join('\n');

        return `TÂCHE: ${task}

    PAGE: ${snapshot.content.url}
    TITRE: ${snapshot.content.title}
    VIEWPORT: ${snapshot.viewport.width}x${snapshot.viewport.height} scroll=${snapshot.viewport.scrollY}/${snapshot.viewport.totalHeight}

    ÉLÉMENTS (${relevantElements.length}/${snapshot.interactive.length}):
    ${compactElements}

    CONTENU:
    ${relevantContent}`;
      }

      /**
       * Filtre les éléments interactifs par pertinence à la tâche
       *
       * Heuristiques :
       * - Priorité aux éléments dans le viewport
       * - Priorité aux éléments dont le nom/label match des mots de la tâche
       * - Toujours inclure : inputs, boutons submit, liens de navigation
       * - Exclure : liens de footer, icônes sociales, éléments désactivés
       */
      private static filterRelevantElements(
        task: string,
        elements: InteractiveElement[]
      ): InteractiveElement[] {
        const taskWords = task
          .toLowerCase()
          .split(/\s+/)
          .filter((w) => w.length > 2);

        const scored = elements.map((el) => {
          let score = 0;

          // In viewport = bonus
          if (el.bbox.y >= 0 && el.bbox.y < 800) score += 3;

          // Nom match la tâche
          const nameLower = el.name.toLowerCase();
          for (const word of taskWords) {
            if (nameLower.includes(word)) score += 5;
          }

          // Type d'élément important
          if (el.role === 'input-text' || el.role === 'input-search') score += 4;
          if (el.role === 'button') score += 2;
          if (el.role === 'combobox') score += 3;
          if (el.tag === 'input' && el.type === 'submit') score += 4;

          // Pénalités
          if (el.disabled) score -= 10;
          if (el.href?.includes('facebook.com') || el.href?.includes('twitter.com')) score -= 5;
          if (el.name.toLowerCase().includes('cookie')) score -= 3;

          return { el, score };
        });

        // Garder les top 80 éléments (balance pertinence/exhaustivité)
        return scored
          .sort((a, b) => b.score - a.score)
          .slice(0, 80)
          .map((s) => s.el);
      }

      /**
       * Extrait les parties du texte les plus pertinentes
       */
      private static extractRelevantContent(task: string, text: string): string {
        if (text.length < 2000) return text;

        const taskWords = task.toLowerCase().split(/\s+/).filter((w) => w.length > 3);
        const paragraphs = text.split(/\n\n|\n/).filter((p) => p.trim().length > 20);

        // Scorer chaque paragraphe
        const scored = paragraphs.map((p) => {
          let score = 0;
          const pLower = p.toLowerCase();
          for (const word of taskWords) {
            if (pLower.includes(word)) score++;
          }
          return { text: p, score };
        });

        // Prendre les paragraphes les plus pertinents, dans l'ordre original
        const relevant = scored
          .filter((s) => s.score > 0)
          .slice(0, 10);

        if (relevant.length === 0) {
          // Fallback : premiers 2000 chars
          return text.slice(0, 2000);
        }

        return relevant.map((r) => r.text).join('\n\n').slice(0, 2000);
      }
    }

    Blocage critique #8 : Détection anti-bot

    Certains sites détectent les interactions scripté (reCAPTCHA, Cloudflare Turnstile, détection de timing trop régulier).
    Solution : Humanisation des inputs

    TypeScript

    // src/content/humanized-input.ts

    /**
     * Simule un comportement humain réaliste pour éviter la détection
     */
    export class HumanizedInput {

      /**
       * Click avec mouvement de souris simulé
       */
      static async humanClick(element: HTMLElement): Promise<void> {
        const rect = element.getBoundingClientRect();

        // Position aléatoire dans l'élément (pas exactement au centre)
        const x = rect.x + rect.width * (0.3 + Math.random() * 0.4);
        const y = rect.y + rect.height * (0.3 + Math.random() * 0.4);

        // Séquence réaliste avec timings variables
        element.scrollIntoView({ behavior: 'smooth', block: 'center' });
        await this.randomDelay(100, 300);

        // Pointer events avec timing humain
        element.dispatchEvent(new PointerEvent('pointerover', {
          clientX: x, clientY: y, bubbles: true
        }));
        await this.randomDelay(30, 80);

        element.dispatchEvent(new PointerEvent('pointerdown', {
          clientX: x, clientY: y, bubbles: true, button: 0
        }));
        await this.randomDelay(50, 150); // Durée de pression humaine

        element.dispatchEvent(new PointerEvent('pointerup', {
          clientX: x, clientY: y, bubbles: true, button: 0
        }));

        element.dispatchEvent(new MouseEvent('click', {
          clientX: x, clientY: y, bubbles: true, button: 0
        }));
      }

      /**
       * Frappe au clavier avec timing variable par caractère
       * Simule la vitesse de frappe humaine (~40-80 WPM)
       */
      static async humanType(element: HTMLInputElement, text: string): Promise<void> {
        element.focus();
        await this.randomDelay(100, 200);

        // Clear
        element.select?.();
        element.dispatchEvent(new KeyboardEvent('keydown', { key: 'a', ctrlKey: true, bubbles: true }));
        await this.randomDelay(30, 60);
        element.value = '';
        element.dispatchEvent(new Event('input', { bubbles: true }));
        await this.randomDelay(50, 100);

        for (let i = 0; i < text.length; i++) {
          const char = text[i];

          // Délai inter-caractère variable (Gaussian-like)
          const baseDelay = 50; // ~60 WPM
          const variation = this.gaussianRandom() * 30;
          await this.randomDelay(
            Math.max(20, baseDelay + variation - 15),
            baseDelay + variation + 25
          );

          // Typos occasionnels (1% de chance) pour sembler humain
          // En production tu peux désactiver ça
          /*
          if (Math.random() < 0.01 && i < text.length - 1) {
            const wrongChar = this.nearbyKey(char);
            await this.typeChar(element, wrongChar);
            await this.randomDelay(100, 300); // pause "réalisation"
            await this.deleteChar(element);
            await this.randomDelay(50, 100);
          }
          */

          // Frappe normale
          element.dispatchEvent(new KeyboardEvent('keydown', {
            key: char, bubbles: true, cancelable: true
          }));

          element.value += char;
          element.dispatchEvent(new InputEvent('input', {
            data: char, inputType: 'insertText', bubbles: true
          }));

          element.dispatchEvent(new KeyboardEvent('keyup', {
            key: char, bubbles: true
          }));

          // Pause plus longue après espace ou ponctuation
          if (char === ' ' || '.!?,;:'.includes(char)) {
            await this.randomDelay(80, 200);
          }
        }

        // Pause avant de blur (humain réfléchit un instant)
        await this.randomDelay(200, 500);
        element.dispatchEvent(new Event('change', { bubbles: true }));
      }

      private static randomDelay(min: number, max: number): Promise<void> {
        const delay = min + Math.random() * (max - min);
        return new Promise((r) => setTimeout(r, delay));
      }

      private static gaussianRandom(): number {
        // Approximation de distribution gaussienne via Box-Muller
        const u1 = Math.random();
        const u2 = Math.random();
        return Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);
      }
    }

