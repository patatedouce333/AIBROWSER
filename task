    // src/content/action-executor.ts

    import { ActionStep, InteractiveElement } from '../shared/messages';

    interface ExecutionResult {
      success: boolean;
      error?: string;
      done?: boolean;
      summary?: string;
    }

    export class ActionExecutor {

      static async execute(
        action: ActionStep,
        elements: InteractiveElement[]
      ): Promise<ExecutionResult> {
        try {
          switch (action.action) {
            case 'click':     return await this.click(action, elements);
            case 'type':      return await this.typeText(action, elements);
            case 'select':    return await this.selectOption(action, elements);
            case 'scroll':    return this.scroll(action);
            case 'wait':      return await this.waitFor(action);
            case 'press_key': return this.pressKey(action);
            case 'navigate':
              if (action.url) window.location.href = action.url;
              return { success: true };
            case 'done':
              return { success: true, done: true, summary: action.summary };
            default:
              return { success: false, error: `Unknown action: ${action.action}` };
          }
        } catch (e: any) {
          return { success: false, error: e.message };
        }
      }

      private static resolveElement(
        action: ActionStep,
        elements: InteractiveElement[]
      ): HTMLElement | null {
        // Stratégie 1: par element_id
        if (action.element_id != null) {
          const meta = elements.find((e) => e.id === action.element_id);
          if (meta?.selector) {
            const el = document.querySelector(meta.selector) as HTMLElement;
            if (el) return el;
          }
        }

        // Stratégie 2: par selector direct
        if (action.selector) {
          const el = document.querySelector(action.selector) as HTMLElement;
          if (el) return el;
        }

        // Stratégie 3: par accessible name (fallback)
        if (action.element_id != null) {
          const meta = elements.find((e) => e.id === action.element_id);
          if (meta?.name) {
            // Chercher par aria-label ou texte
            const candidates = document.querySelectorAll(
              `[aria-label="${meta.name}"], ${meta.tag}`
            );
            for (const c of candidates) {
              if (c.textContent?.trim().startsWith(meta.name.slice(0, 20))) {
                return c as HTMLElement;
              }
            }
          }
        }

        return null;
      }

      private static async click(
        action: ActionStep,
        elements: InteractiveElement[]
      ): Promise<ExecutionResult> {
        const el = this.resolveElement(action, elements);
        if (!el) return { success: false, error: `Element ${action.element_id} not found` };

        // Scroll into view
        el.scrollIntoView({ behavior: 'instant', block: 'center' });
        await this.sleep(50);

        // Vérifier que l'élément est cliquable (pas couvert par un overlay)
        const rect = el.getBoundingClientRect();
        const centerX = rect.x + rect.width / 2;
        const centerY = rect.y + rect.height / 2;
        const topElement = document.elementFromPoint(centerX, centerY);

        if (topElement && !el.contains(topElement) && topElement !== el) {
          // Un overlay couvre l'élément — essayer de cliquer quand même
          console.warn('Element may be covered by overlay, attempting click anyway');
        }

        // Simuler un vrai click utilisateur
        const eventInit: MouseEventInit = {
          bubbles: true,
          cancelable: true,
          clientX: centerX,
          clientY: centerY,
          button: 0,
        };

        el.dispatchEvent(new PointerEvent('pointerover', eventInit));
        el.dispatchEvent(new PointerEvent('pointerenter', { ...eventInit, bubbles: false }));
        el.dispatchEvent(new MouseEvent('mouseover', eventInit));
        el.dispatchEvent(new MouseEvent('mouseenter', { ...eventInit, bubbles: false }));
        el.dispatchEvent(new PointerEvent('pointerdown', eventInit));
        el.dispatchEvent(new MouseEvent('mousedown', eventInit));
        el.focus();
        el.dispatchEvent(new PointerEvent('pointerup', eventInit));
        el.dispatchEvent(new MouseEvent('mouseup', eventInit));
        el.dispatchEvent(new MouseEvent('click', eventInit));

        return { success: true };
      }

      private static async typeText(
        action: ActionStep,
        elements: InteractiveElement[]
      ): Promise<ExecutionResult> {
        const el = this.resolveElement(action, elements) as HTMLInputElement;
        if (!el) return { success: false, error: `Element ${action.element_id} not found` };
        if (!action.text) return { success: false, error: 'No text to type' };

        el.focus();

        // Sélectionner tout le contenu existant et le remplacer
        el.select?.();
        document.execCommand('selectAll', false);

        // Utiliser InputEvent pour la compatibilité React/Vue/Angular
        // Ces frameworks écoutent des events spécifiques
        el.value = '';
        el.dispatchEvent(new Event('input', { bubbles: true }));

        // Typer caractère par caractère pour les frameworks réactifs
        for (const char of action.text) {
          // KeyboardEvent pour les listeners keydown/keyup
          el.dispatchEvent(new KeyboardEvent('keydown', {
            key: char, code: `Key${char.toUpperCase()}`,
            bubbles: true, cancelable: true,
          }));

          el.dispatchEvent(new KeyboardEvent('keypress', {
            key: char, code: `Key${char.toUpperCase()}`,
            bubbles: true, cancelable: true,
          }));

          // InputEvent pour React synthetic events
          el.value += char;
          el.dispatchEvent(new InputEvent('input', {
            data: char,
            inputType: 'insertText',
            bubbles: true,
            cancelable: true,
          }));

          el.dispatchEvent(new KeyboardEvent('keyup', {
            key: char, code: `Key${char.toUpperCase()}`,
            bubbles: true, cancelable: true,
          }));

          // Setter natif pour React controlled components
          const nativeInputValueSetter = Object.getOwnPropertyDescriptor(
            window.HTMLInputElement.prototype, 'value'
          )?.set;
          if (nativeInputValueSetter) {
            nativeInputValueSetter.call(el, el.value);
            el.dispatchEvent(new Event('input', { bubbles: true }));
          }

          await this.sleep(15);
        }

        el.dispatchEvent(new Event('change', { bubbles: true }));
        el.dispatchEvent(new Event('blur', { bubbles: true }));

        return { success: true };
      }

      private static async selectOption(
        action: ActionStep,
        elements: InteractiveElement[]
      ): Promise<ExecutionResult> {
        const el = this.resolveElement(action, elements) as HTMLSelectElement;
        if (!el) return { success: false, error: `Element ${action.element_id} not found` };
        if (!action.value) return { success: false, error: 'No value to select' };

        el.value = action.value;
        el.dispatchEvent(new Event('change', { bubbles: true }));
        el.dispatchEvent(new Event('input', { bubbles: true }));

        return { success: true };
      }

      private static scroll(action: ActionStep): ExecutionResult {
        const amount = action.direction === 'down' ? 600 : -600;
        window.scrollBy({ top: amount, behavior: 'instant' });
        return { success: true };
      }

      private static async waitFor(action: ActionStep): Promise<ExecutionResult> {
        const timeout = action.timeout_ms || 5000;
        const interval = 100;
        const start = Date.now();

        while (Date.now() - start < timeout) {
          if (action.condition === 'selector_visible' && action.selector) {
            const el = document.querySelector(action.selector);
            if (el && (el as HTMLElement).offsetParent !== null) {
              return { success: true };
            }
          }

          if (action.condition === 'url_contains' && action.text) {
            if (window.location.href.includes(action.text)) {
              return { success: true };
            }
          }

          if (action.condition === 'page_loaded') {
            if (document.readyState === 'complete') {
              return { success: true };
            }
          }

          await this.sleep(interval);
        }

        return {
          success: false,
          error: `Wait timeout after ${timeout}ms: ${action.condition} ${action.selector || ''}`,
        };
      }

      private static pressKey(action: ActionStep): ExecutionResult {
        if (!action.key) return { success: false, error: 'No key specified' };

        const activeEl = document.activeElement || document.body;
        const eventInit: KeyboardEventInit = {
          key: action.key,
          code: action.key === 'Enter' ? 'Enter' : `Key${action.key}`,
          bubbles: true,
          cancelable: true,
        };

        activeEl.dispatchEvent(new KeyboardEvent('keydown', eventInit));
        activeEl.dispatchEvent(new KeyboardEvent('keypress', eventInit));
        activeEl.dispatchEvent(new KeyboardEvent('keyup', eventInit));

        return { success: true };
      }

      private static sleep(ms: number): Promise<void> {
        return new Promise((r) => setTimeout(r, ms));
      }
    }

