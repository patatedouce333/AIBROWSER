    // content/content-script.js

    import { DOMExtractor } from './dom-extractor.js';
    import { ActionExecutor } from './action-executor.js';

    chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
      handleContentMessage(msg).then(sendResponse);
      return true;
    });

    async function handleContentMessage(msg) {
      switch (msg.type) {
        case 'GET_SNAPSHOT':
          return DOMExtractor.fullSnapshot();

        case 'EXECUTE_ACTION':
          return ActionExecutor.execute(msg.action, msg.elements);

        case 'GET_SELECTED_TEXT':
          return { text: window.getSelection()?.toString() || '' };
      }
    }

