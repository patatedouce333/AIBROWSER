    Task 2.4 — Option B : Proxy backend local avec ADC natif (plus robuste)

    Cette option élimine complètement le problème de tokens dans l'extension en déléguant l'auth à un processus local qui utilise ADC nativement.

    TypeScript

    // proxy-server/server.ts

    import http from 'http';
    import { GoogleAuth } from 'google-auth-library';

    const PROJECT_ID = process.env.PROJECT_ID || 'project-5f9c90a7-b952-41df-a41';
    const REGION = process.env.REGION || 'us-central1';
    const PORT = parseInt(process.env.PORT || '8787');

    // ADC natif — lit automatiquement ~/.config/gcloud/application_default_credentials.json
    // Gère le refresh automatiquement, zéro configuration
    const auth = new GoogleAuth({
      scopes: ['https://www.googleapis.com/auth/cloud-platform'],
    });

    const server = http.createServer(async (req, res) => {
      // CORS pour l'extension Chrome
      res.setHeader('Access-Control-Allow-Origin', `chrome-extension://${req.headers['origin']?.split('//')<!--citation:1--> || '*'}`);
      res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
      res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

      if (req.method === 'OPTIONS') {
        res.writeHead(204);
        res.end();
        return;
      }

      if (req.method !== 'POST') {
        res.writeHead(405);
        res.end('Method not allowed');
        return;
      }

      try {
        // Lire le body de la requête
        const body = await readBody(req);
        const { model, contents, systemInstruction, generationConfig, stream } = JSON.parse(body);

        // Obtenir un token frais via ADC (auto-refresh géré par google-auth-library)
        const client = await auth.getClient();
        const tokenResponse = await client.getAccessToken();
        const token = tokenResponse.token;

        const vertexModel = model || 'gemini-2.0-flash';
        const endpoint = stream ? 'streamGenerateContent?alt=sse' : 'generateContent';
        const vertexUrl =
          `https://${REGION}-aiplatform.googleapis.com/v1/` +
          `projects/${PROJECT_ID}/locations/${REGION}/` +
          `publishers/google/models/${vertexModel}:${endpoint}`;

        const vertexBody: any = { contents };
        if (systemInstruction) vertexBody.systemInstruction = systemInstruction;
        if (generationConfig) vertexBody.generationConfig = generationConfig;

        const vertexResponse = await fetch(vertexUrl, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(vertexBody),
        });

        if (stream) {
          // Proxy le stream SSE directement
          res.writeHead(vertexResponse.status, {
            'Content-Type': 'text/event-stream',
            'Cache-Control': 'no-cache',
            'Connection': 'keep-alive',
          });

          const reader = vertexResponse.body!.getReader();
          const pump = async () => {
            while (true) {
              const { done, value } = await reader.read();
              if (done) break;
              res.write(value);
            }
            res.end();
          };
          pump();
        } else {
          const data = await vertexResponse.json();
          res.writeHead(vertexResponse.status, { 'Content-Type': 'application/json' });
          res.end(JSON.stringify(data));
        }
      } catch (error: any) {
        res.writeHead(500, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ error: error.message }));
      }
    });

    function readBody(req: http.IncomingMessage): Promise<string> {
      return new Promise((resolve, reject) => {
        const chunks: Buffer[] = [];
        req.on('data', (chunk) => chunks.push(chunk));
        req.on('end', () => resolve(Buffer.concat(chunks).toString()));
        req.on('error', reject);
      });
    }

    server.listen(PORT, '127.0.0.1', () => {
      console.log(`Vertex AI proxy listening on http://127.0.0.1:${PORT}`);
      console.log(`Project: ${PROJECT_ID}, Region: ${REGION}`);
    });

