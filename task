    Smart Completion Detection

    Un problème non-trivial résolu dans le MCP server — détecter quand Perplexity a fini de streamer sa réponse :

    TypeScript

    // Pas de signal explicite "done" dans le DOM
    // Solution identifiée : polling du DOM avec heuristiques

    async function waitForCompletion(page: CDPPage): Promise<string> {
      let previousContent = "";
      let stableCount = 0;
      const STABILITY_THRESHOLD = 3; // checks consécutifs identiques
      const POLL_INTERVAL = 500; // ms

      while (stableCount < STABILITY_THRESHOLD) {
        const currentContent = await page.evaluate(() => {
          // Sélecteur CSS spécifique au DOM de Perplexity
          const responseEl = document.querySelector(
            '[class*="prose"] .markdown-content'
            // ou variantes selon les mises à jour UI
          );
          return responseEl?.textContent || "";
        });

        if (currentContent === previousContent && currentContent.length > 0) {
          stableCount++;
        } else {
          stableCount = 0;
        }
        previousContent = currentContent;
        await sleep(POLL_INTERVAL);
      }

      return previousContent;
    }

