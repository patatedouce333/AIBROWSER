    // background/auth-manager.js

    const SCOPES = ['https://www.googleapis.com/auth/cloud-platform'];

    export class AuthManager {
      #tokenCache = null;
      #tokenExpiry = 0;

      /**
       * Obtient un access token via chrome.identity (OAuth2)
       * PAS de clé API — utilise le flow OAuth2 interactif
       * L'utilisateur se connecte avec son compte Google org
       */
      async getAccessToken(interactive = true) {
        // Cache hit
        if (this.#tokenCache && Date.now() < this.#tokenExpiry - 60000) {
          return this.#tokenCache;
        }

        return new Promise((resolve, reject) => {
          chrome.identity.getAuthToken(
            { interactive, scopes: SCOPES },
            (token) => {
              if (chrome.runtime.lastError) {
                reject(new Error(chrome.runtime.lastError.message));
                return;
              }
              this.#tokenCache = token;
              // Chrome gère l'expiry, mais on cache pour 50 min
              this.#tokenExpiry = Date.now() + 50 * 60 * 1000;
              resolve(token);
            }
          );
        });
      }

      /**
       * Force le refresh du token
       */
      async refreshToken() {
        return new Promise((resolve, reject) => {
          chrome.identity.getAuthToken({ interactive: false }, (token) => {
            if (token) {
              // Invalider l'ancien token puis en obtenir un nouveau
              chrome.identity.removeCachedAuthToken({ token }, () => {
                this.#tokenCache = null;
                this.#tokenExpiry = 0;
                this.getAccessToken(false).then(resolve).catch(reject);
              });
            } else {
              this.getAccessToken(true).then(resolve).catch(reject);
            }
          });
        });
      }

      /**
       * Alternative : Service Account Impersonation
       * Pour les cas où tu veux des permissions restreintes
       */
      async getImpersonatedToken(serviceAccountEmail) {
        const userToken = await this.getAccessToken();

        const response = await fetch(
          `https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/${serviceAccountEmail}:generateAccessToken`,
          {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${userToken}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              scope: SCOPES,
              lifetime: '3600s'
            })
          }
        );

        const data = await response.json();
        return data.accessToken;
      }
    }

