    Task 5.1 : action-planner.js

    JavaScript

    // background/action-planner.js

    import { VertexAIClient } from './vertex-client.js';

    const SYSTEM_PROMPT = `Tu es un agent de navigation web. 
    Tu reçois un snapshot de la page (éléments interactifs + contenu).
    Tu dois générer un PLAN COMPLET d'actions pour accomplir la tâche.

    RÈGLES:
    - Génère TOUTES les étapes d'un coup, pas une seule
    - Utilise les IDs des éléments interactifs fournis
    - Types d'actions: click, type, select, scroll, wait, navigate, done
    - Pour les actions irréversibles (achat, envoi), ajoute "confirm": true
    - Si tu n'es pas sûr de l'élément, ajoute "fallback_strategy": "vision"

    FORMAT: JSON array strict, pas de markdown
    [
      {"step": 1, "action": "click", "element_id": 5, "reason": "..."},
      {"step": 2, "action": "type", "element_id": 12, "text": "...", "reason": "..."},
      {"step": 3, "action": "wait", "condition": "selector_visible", "selector": "...", "timeout_ms": 3000},
      {"step": 4, "action": "done", "summary": "..."}
    ]`;

    export class ActionPlanner {
      #vertex = new VertexAIClient();

      /**
       * UN SEUL appel LLM pour tout le plan
       */
      async generatePlan(task, pageSnapshot) {
        const userPrompt = `
    TÂCHE: ${task}

    PAGE: ${pageSnapshot.content.url}
    TITRE: ${pageSnapshot.content.title}
    VIEWPORT: ${pageSnapshot.viewport.width}x${pageSnapshot.viewport.height}

    ÉLÉMENTS INTERACTIFS:
    ${JSON.stringify(pageSnapshot.interactive.slice(0, 150), null, 2)}

    CONTENU RÉSUMÉ:
    ${pageSnapshot.content.text.slice(0, 3000)}

    Génère le plan d'actions.`;

        const response = await this.#vertex.generateContent(userPrompt, {
          systemInstruction: SYSTEM_PROMPT,
          temperature: 0.1, // déterministe pour les plans d'action
          jsonMode: true,
          model: 'gemini-2.0-flash', // flash pour la vitesse du planning
        });

        const text = response.candidates.content.parts.text;
        return JSON.parse(text);
      }

      /**
       * Re-plan si une étape échoue (avec contexte mis à jour)
       */
      async replan(failedStep, error, remainingSteps, newSnapshot) {
        const prompt = `
    L'étape ${failedStep.step} a échoué: ${error}
    Plan restant qui n'a pas pu s'exécuter: ${JSON.stringify(remainingSteps)}
    Nouveau snapshot de la page: ${JSON.stringify(newSnapshot.interactive.slice(0, 100))}

    Génère un nouveau plan à partir de l'état actuel.`;

        return this.generatePlan(prompt, newSnapshot);
      }
    }

    Phase 6 — Action Executor (content script)
    Task 6.1 : action-executor.js

    JavaScript

    // content/action-executor.js

    export class ActionExecutor {

      /**
       * Exécute une action unique sur la page
       * Retourne {success: boolean, error?: string}
       */
      static async execute(action, interactiveElements) {
        try {
          switch (action.action) {
            case 'click':
              return await this.#click(action, interactiveElements);
            case 'type':
              return await this.#type(action, interactiveElements);
            case 'select':
              return await this.#select(action, interactiveElements);
            case 'scroll':
              return await this.#scroll(action);
            case 'wait':
              return await this.#wait(action);
            case 'navigate':
              window.location.href = action.url;
              return { success: true };
            case 'done':
              return { success: true, done: true, summary: action.summary };
            default:
              return { success: false, error: `Unknown action: ${action.action}` };
          }
        } catch (e) {
          return { success: false, error: e.message };
        }
      }

      static async #click(action, elements) {
        const el = this.#resolveElement(action, elements);
        if (!el) return { success: false, error: 'Element not found' };

        // Scroll into view d'abord
        el.scrollIntoView({ behavior: 'instant', block: 'center' });
        await this.#sleep(50);

        // Dispatch des events natifs (pas just .click())
        el.dispatchEvent(new PointerEvent('pointerdown', { bubbles: true }));
        el.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
        el.dispatchEvent(new PointerEvent('pointerup', { bubbles: true }));
        el.dispatchEvent(new MouseEvent('mouseup', { bubbles: true }));
        el.dispatchEvent(new MouseEvent('click', { bubbles: true }));

        return { success: true };
      }

      static async #type(action, elements) {
        const el = this.#resolveElement(action, elements);
        if (!el) return { success: false, error: 'Element not found' };

        el.focus();
        // Clear existing value
        el.value = '';
        el.dispatchEvent(new Event('input', { bubbles: true }));

        // Type char by char pour les sites qui écoutent keydown
        for (const char of action.text) {
          el.dispatchEvent(new KeyboardEvent('keydown', {
            key: char, bubbles: true
          }));
          el.value += char;
          el.dispatchEvent(new Event('input', { bubbles: true }));
          el.dispatchEvent(new KeyboardEvent('keyup', {
            key: char, bubbles: true
          }));
          // Micro-delay pour les debounced handlers
          await this.#sleep(10);
        }

        el.dispatchEvent(new Event('change', { bubbles: true }));
        return { success: true };
      }

      static async #wait(action) {
        const timeout = action.timeout_ms || 5000;
        const start = Date.now();

        while (Date.now() - start < timeout) {
          if (action.condition === 'selector_visible') {
            const el = document.querySelector(action.selector);
            if (el && el.offsetParent !== null) return { success: true };
          }
          await this.#sleep(100);
        }

        return { success: false, error: `Wait timeout: ${action.condition}` };
      }

      static async #scroll(action) {
        window.scrollBy({
          top: action.direction === 'down' ? 500 : -500,
          behavior: 'instant'
        });
        return { success: true };
      }

      static async #select(action, elements) {
        const el = this.#resolveElement(action, elements);
        if (!el) return { success: false, error: 'Element not found' };
        el.value = action.value;
        el.dispatchEvent(new Event('change', { bubbles: true }));
        return { success: true };
      }

      static #resolveElement(action, elements) {
        // Priority 1: par element_id de notre snapshot
        if (action.element_id != null && elements[action.element_id]) {
          const meta = elements[action.element_id];
          return document.querySelector(meta.selector);
        }
        // Priority 2: par selector direct
        if (action.selector) {
          return document.querySelector(action.selector);
        }
        return null;
      }

      static #sleep(ms) {
        return new Promise(r => setTimeout(r, ms));
      }
    }

