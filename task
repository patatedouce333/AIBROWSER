    Task 2.2 : Token Store sécurisé

    TypeScript

    // src/background/token-store.ts

    interface StoredToken {
      accessToken: string;
      refreshToken: string;
      expiresAt: number; // timestamp ms
      scope: string;
    }

    export class TokenStore {
      private static readonly STORAGE_KEY = 'vertex_oauth_tokens';

      static async save(token: StoredToken): Promise<void> {
        // chrome.storage.session est en mémoire uniquement,
        // plus sécurisé que chrome.storage.local pour les tokens
        await chrome.storage.session.set({
          [this.STORAGE_KEY]: token
        });
      }

      static async get(): Promise<StoredToken | null> {
        const result = await chrome.storage.session.get(this.STORAGE_KEY);
        return result[this.STORAGE_KEY] || null;
      }

      static async clear(): Promise<void> {
        await chrome.storage.session.remove(this.STORAGE_KEY);
      }

      static isExpired(token: StoredToken): boolean {
        // 5 minutes de marge avant expiration
        return Date.now() > token.expiresAt - 5 * 60 * 1000;
      }
    }

    Task 2.3 — Option A : OAuth2 via launchWebAuthFlow (pure extension, sans backend)

    TypeScript

    // src/background/auth-manager.ts

    import { TokenStore } from './token-store';

    // Ces valeurs viennent de la console GCP (OAuth Client ID type Web Application)
    const OAUTH_CONFIG = {
      clientId: 'VOTRE_CLIENT_ID.apps.googleusercontent.com',
      clientSecret: 'VOTRE_CLIENT_SECRET', // Stocké dans le service worker
      // Le redirect URI est automatiquement généré par Chrome
      // Format: https://<extension-id>.chromiumapp.org/
      redirectUri: `https://${chrome.runtime.id}.chromiumapp.org/`,
      authEndpoint: 'https://accounts.google.com/o/oauth2/v2/auth',
      tokenEndpoint: 'https://oauth2.googleapis.com/token',
      scope: 'https://www.googleapis.com/auth/cloud-platform',
    };

    export class AuthManager {

      /**
       * Obtient un access token valide.
       * Gère le cache, le refresh, et le login interactif.
       */
      async getAccessToken(): Promise<string> {
        // 1. Vérifier le cache
        const stored = await TokenStore.get();
        if (stored && !TokenStore.isExpired(stored)) {
          return stored.accessToken;
        }

        // 2. Tenter un refresh silencieux
        if (stored?.refreshToken) {
          try {
            const refreshed = await this.refreshAccessToken(stored.refreshToken);
            return refreshed.accessToken;
          } catch (e) {
            console.warn('Token refresh failed, re-auth needed:', e);
          }
        }

        // 3. Login interactif
        return this.interactiveLogin();
      }

      /**
       * Flow OAuth2 interactif via chrome.identity.launchWebAuthFlow
       *
       * C'est ici la différence critique avec getAuthToken :
       * - launchWebAuthFlow ouvre une vraie fenêtre OAuth Google
       * - Supporte TOUS les scopes GCP, y compris cloud-platform
       * - Retourne un authorization code qu'on échange contre des tokens
       */
      private async interactiveLogin(): Promise<string> {
        // Générer un state anti-CSRF
        const state = crypto.randomUUID();

        // Construire l'URL d'autorisation
        const authUrl = new URL(OAUTH_CONFIG.authEndpoint);
        authUrl.searchParams.set('client_id', OAUTH_CONFIG.clientId);
        authUrl.searchParams.set('redirect_uri', OAUTH_CONFIG.redirectUri);
        authUrl.searchParams.set('response_type', 'code');
        authUrl.searchParams.set('scope', OAUTH_CONFIG.scope);
        authUrl.searchParams.set('state', state);
        authUrl.searchParams.set('access_type', 'offline');     // pour le refresh_token
        authUrl.searchParams.set('prompt', 'consent');           // forcer le consent pour
                                                                 // obtenir refresh_token

        // Lancer le flow OAuth
        const responseUrl = await chrome.identity.launchWebAuthFlow({
          url: authUrl.toString(),
          interactive: true, // ouvre la fenêtre de consentement
        });

        // Parser la réponse
        const url = new URL(responseUrl);
        const code = url.searchParams.get('code');
        const returnedState = url.searchParams.get('state');

        if (returnedState !== state) {
          throw new Error('CSRF state mismatch');
        }

        if (!code) {
          throw new Error(`OAuth error: ${url.searchParams.get('error')}`);
        }

        // Échanger le code contre des tokens
        const tokens = await this.exchangeCodeForTokens(code);
        return tokens.accessToken;
      }

      /**
       * Échange le authorization code contre access_token + refresh_token
       */
      private async exchangeCodeForTokens(code: string): Promise<{ accessToken: string }> {
        const response = await fetch(OAUTH_CONFIG.tokenEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            code,
            client_id: OAUTH_CONFIG.clientId,
            client_secret: OAUTH_CONFIG.clientSecret,
            redirect_uri: OAUTH_CONFIG.redirectUri,
            grant_type: 'authorization_code',
          }),
        });

        if (!response.ok) {
          const error = await response.json();
          throw new Error(`Token exchange failed: ${JSON.stringify(error)}`);
        }

        const data = await response.json();

        const tokenData = {
          accessToken: data.access_token,
          refreshToken: data.refresh_token,
          expiresAt: Date.now() + data.expires_in * 1000,
          scope: data.scope,
        };

        await TokenStore.save(tokenData);
        return tokenData;
      }

      /**
       * Refresh silencieux du token — résout le problème d'expiration 1-12h
       * documenté dans open-webui/discussions/10030
       */
      private async refreshAccessToken(refreshToken: string): Promise<{ accessToken: string }> {
        const response = await fetch(OAUTH_CONFIG.tokenEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            refresh_token: refreshToken,
            client_id: OAUTH_CONFIG.clientId,
            client_secret: OAUTH_CONFIG.clientSecret,
            grant_type: 'refresh_token',
          }),
        });

        if (!response.ok) {
          await TokenStore.clear();
          throw new Error('Refresh token expired or revoked');
        }

        const data = await response.json();

        const tokenData = {
          accessToken: data.access_token,
          refreshToken: refreshToken, // Google ne renvoie pas toujours un nouveau refresh_token
          expiresAt: Date.now() + data.expires_in * 1000,
          scope: data.scope,
        };

        await TokenStore.save(tokenData);
        return tokenData;
      }

      /**
       * Impersonation de Service Account (pour principe du moindre privilège)
       *
       * Flow : User OAuth token → appel IAM Credentials API
       *        → obtient un token SA avec permissions restreintes
       */
      async getImpersonatedToken(): Promise<string> {
        const userToken = await this.getAccessToken();

        const SA_EMAIL = `comet-ext-sa@${CONSTANTS.PROJECT_ID}.iam.gserviceaccount.com`;

        const response = await fetch(
          `https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/${SA_EMAIL}:generateAccessToken`,
          {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${userToken}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              scope: ['https://www.googleapis.com/auth/cloud-platform'],
              lifetime: '3600s', // max 1h, puis auto-refresh
            }),
          }
        );

        if (!response.ok) {
          const error = await response.json();
          throw new Error(`Impersonation failed: ${JSON.stringify(error)}`);
        }

        const data = await response.json();
        return data.accessToken;
      }

      async logout(): Promise<void> {
        await TokenStore.clear();
      }
    }

